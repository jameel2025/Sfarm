<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Farm Management System"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnManageEmployees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Employees"
        android:layout_marginBottom="16dp"
        android:textSize="18sp"/>

    <Button
        android:id="@+id/btnManageEquipment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Equipment"
        android:layout_marginBottom="16dp"
        android:textSize="18sp"/>

    <Button
        android:id="@+id/btnManageFarms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Farms"
        android:layout_marginBottom="16dp"
        android:textSize="18sp"/>

    <Button
        android:id="@+id/btnManageYards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Yards"
        android:textSize="18sp"/>

</LinearLayout>
